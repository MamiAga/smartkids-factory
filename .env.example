
# Android Control Center build-time config (read by the Secrets Gradle Plugin into BuildConfig).
# Copy to .env (git-ignored). NEVER put SUPABASE_SECRET_KEY here — it lives only in GitHub Secrets.

GEMINI_API_KEY=DEFAULT_GEMINI_API_KEY
SUPABASE_URL=DEFAULT_SUPABASE_URL
# publishable / anon key only
SUPABASE_ANON_KEY=DEFAULT_SUPABASE_ANON_KEY
# Fine-grained PAT: repository = MamiAga/smartkids-factory ONLY, permission "Actions: Read and write",
# nothing else, with an expiry date. It is embedded in the APK, so keep the APK private.
# Used for: START (run now), test production from the phone, STOP (cancel running cloud runs).
# Without it START still works: Supabase enabled=true and the hourly cron picks it up (<= 1 h).
GITHUB_PAT=DEFAULT_GITHUB_PAT
